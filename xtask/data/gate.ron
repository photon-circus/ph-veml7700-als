(
    default_profile: "full",
    profiles: {
        "full": (
            package_allow_dirty: true,
            skip_steps: [],
            skip_notes: {},
            bare_metal: AllToolchainTargets,
        ),
        "bounded": (
            package_allow_dirty: true,
            skip_steps: ["deny", "xtask_deny", "package"],
            skip_notes: {
                "deny": "cargo-deny is not provisioned for bounded runs; the full gate runs it",
                "xtask_deny": "cargo-deny is not provisioned for bounded runs; the full gate runs it",
                "package": "packaging belongs to the release gate and runs locally",
                "targets": "four of the five supported targets; the full gate compiles all five",
            },
            bare_metal: Selected(["thumbv7em-none-eabihf"]),
        ),
        "release": (
            package_allow_dirty: false,
            skip_steps: [],
            skip_notes: {},
            bare_metal: AllToolchainTargets,
        ),
    },
    steps: [
        (id: "worktree", title: "release worktree is clean", profiles: ["release"]),
        (id: "version", title: "verify the Incubating candidate version", profiles: ["full", "bounded", "release"]),
        (id: "vendor", title: "vendor documents remain untracked", profiles: ["full", "bounded", "release"]),
        (id: "conformance_matrix", title: "the conformance matrix matches the conformance tests", profiles: ["full", "bounded", "release"]),
        (id: "claims", title: "claim registry identifiers resolve", profiles: ["full", "bounded", "release"]),
        (id: "markdown_links", title: "local Markdown links resolve", profiles: ["full", "bounded", "release"]),
        (id: "error_variants", title: "every public error variant is named by some code path", profiles: ["full", "bounded", "release"]),
        (id: "xtask_fmt", title: "xtask formatting", profiles: ["full", "bounded", "release"]),
        (id: "xtask_tests", title: "xtask unit tests", profiles: ["full", "bounded", "release"]),
        (id: "xtask_clippy", title: "xtask lints with warnings denied", profiles: ["full", "bounded", "release"]),
        (id: "fmt", title: "formatting", profiles: ["full", "bounded", "release"]),
        (id: "driver_tests", title: "driver host tests, including doctests, without default features", profiles: ["full", "bounded", "release"]),
        (id: "model_tests", title: "model host tests, independent of the production driver", profiles: ["full", "bounded", "release"]),
        (id: "conformance", title: "driver-versus-model conformance", profiles: ["full", "bounded", "release"]),
        (id: "feature_check", title: "feature-complete compilation", profiles: ["full", "bounded", "release"]),
        (id: "clippy", title: "lints with warnings denied", profiles: ["full", "bounded", "release"]),
        (id: "docs", title: "documentation build", profiles: ["full", "bounded", "release"]),
        (id: "doctests", title: "doctests with all features", profiles: ["full", "bounded", "release"]),
        (id: "targets", title: "supported bare-metal targets", profiles: ["full", "bounded", "release"]),
        (id: "deny", title: "dependency advisory and license policy", profiles: ["full", "bounded", "release"]),
        (id: "xtask_deny", title: "xtask dependency advisory and license policy", profiles: ["full", "bounded", "release"]),
        (id: "package", title: "package construction, inspection, and unpacked test", profiles: ["full", "bounded", "release"]),
    ],
)
