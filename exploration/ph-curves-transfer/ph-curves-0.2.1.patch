@@ -0,0 +1,347 @@
+//! Discrete transfer families: one model, explicit members, no interpolation.
+
+// Host-only: module-local std link (crate root stays `#![no_std]`).
+extern crate std;
+
+use std::collections::BTreeMap;
+use std::format;
+use std::prelude::v1::*;
+
+use serde::Deserialize;
+
+use super::model::ModelDef;
+use super::{default_boundary, BoundaryDef, TransferDef};
+
+/// Hard cap on knots for a family member. Stricter than the standalone
+/// transfer cap (4096): families must not become dense ADC tables.
+pub const FAMILY_MAX_KNOTS_HARD: usize = 256;
+
+fn default_family_max_knots() -> usize {
+    64
+}
+
+fn default_family_max_knots_hard() -> usize {
+    FAMILY_MAX_KNOTS_HARD
+}
+
+/// One named family: shared model, per-member scale and applicability.
+///
+/// Fields are crate-visible. Dependents inspect the map via
+/// [`crate::r#gen::DefinitionsFile::transfer_families`].
+#[derive(Debug, Clone, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct TransferFamilyDef {
+    pub(crate) input_unit: String,
+    pub(crate) output_unit: String,
+    pub(crate) output_scale: u32,
+    pub(crate) max_interpolation_error: u32,
+    #[serde(default = "default_family_max_knots")]
+    pub(crate) max_knots: usize,
+    #[serde(default = "default_family_max_knots_hard")]
+    pub(crate) max_knots_hard: usize,
+    #[serde(default)]
+    pub(crate) interpolate_selectors: bool,
+    #[serde(default = "default_boundary")]
+    pub(crate) below: BoundaryDef,
+    #[serde(default = "default_boundary")]
+    pub(crate) above: BoundaryDef,
+    #[serde(default = "default_boundary")]
+    pub(crate) saturation: BoundaryDef,
+    #[serde(default = "default_boundary")]
+    pub(crate) extrapolation: BoundaryDef,
+    pub(crate) model: ModelDef,
+    pub(crate) members: Vec<FamilyMemberDef>,
+}
+
+/// One explicit selector combination. Never synthesized by interpolation.
+#[derive(Debug, Clone, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct FamilyMemberDef {
+    pub(crate) selectors: BTreeMap<String, toml::Value>,
+    pub(crate) scale_micro_lux_per_count: u32,
+    pub(crate) applicability: ApplicabilityDef,
+}
+
+/// Where this member's mapping is source-backed.
+#[derive(Debug, Clone, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct ApplicabilityDef {
+    pub(crate) correction: CorrectionKind,
+    pub(crate) uncorrected_lux: [f64; 2],
+}
+
+/// Whether the shared model applies to this member.
+#[derive(Debug, Clone, Copy, Deserialize, Eq, PartialEq)]
+#[serde(rename_all = "snake_case")]
+pub enum CorrectionKind {
+    /// Generate this member (default family emission).
+    Required,
+    /// Recorded on the description; not generated.
+    None,
+    /// Recorded as forbidden in this region; not generated.
+    DoNotUse,
+}
+
+/// A channel or procedure the sources do not define as a transfer.
+#[derive(Debug, Clone, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct GapDef {
+    pub(crate) status: GapStatus,
+    pub(crate) reason: String,
+}
+
+/// Only `undefined` is valid: a gap must not be filled with a plausible model.
+#[derive(Debug, Clone, Copy, Deserialize, Eq, PartialEq)]
+#[serde(rename_all = "snake_case")]
+pub enum GapStatus {
+    /// The sources do not define this mapping; do not invent one.
+    Undefined,
+}
+
+/// Expand families into standalone transfer defs. Members that are not
+/// `correction = "required"` are skipped (description-only).
+pub fn expand_families(
+    families: &BTreeMap<String, TransferFamilyDef>,
+) -> Result<BTreeMap<String, TransferDef>, String> {
+    let mut out = BTreeMap::new();
+    for (family_name, family) in families {
+        if family.interpolate_selectors {
+            return Err(format!(
+                "transfer family `{family_name}`: interpolate_selectors = true is not supported; \
+                 list members explicitly"
+            ));
+        }
+        if family.max_knots_hard > FAMILY_MAX_KNOTS_HARD {
+            return Err(format!(
+                "transfer family `{family_name}`: max_knots_hard {} exceeds family cap {FAMILY_MAX_KNOTS_HARD}",
+                family.max_knots_hard
+            ));
+        }
+        if family.max_knots < 2 || family.max_knots > family.max_knots_hard {
+            return Err(format!(
+                "transfer family `{family_name}`: max_knots must be in 2..={}",
+                family.max_knots_hard
+            ));
+        }
+        if matches!(family.extrapolation, BoundaryDef::Clamp) {
+            return Err(format!(
+                "transfer family `{family_name}`: extrapolation = clamp is not supported; \
+                 use error, or list a wider applicability window explicitly"
+            ));
+        }
+        if family.members.is_empty() {
+            return Err(format!(
+                "transfer family `{family_name}`: members must not be empty"
+            ));
+        }
+
+        let mut generated = 0usize;
+        for member in &family.members {
+            if member.applicability.correction != CorrectionKind::Required {
+                continue;
+            }
+            let (member_name, def) = expand_member(family_name, family, member)?;
+            if out.insert(member_name.clone(), def).is_some() {
+                return Err(format!(
+                    "transfer family `{family_name}`: duplicate expanded name `{member_name}`"
+                ));
+            }
+            generated += 1;
+        }
+        if generated == 0 {
+            return Err(format!(
+                "transfer family `{family_name}`: no members with correction = \"required\""
+            ));
+        }
+    }
+    Ok(out)
+}
+
+fn expand_member(
+    family_name: &str,
+    family: &TransferFamilyDef,
+    member: &FamilyMemberDef,
+) -> Result<(String, TransferDef), String> {
+    if member.scale_micro_lux_per_count == 0 {
+        return Err(format!(
+            "transfer family `{family_name}`: scale_micro_lux_per_count must be positive"
+        ));
+    }
+    let [lux_lo, lux_hi] = member.applicability.uncorrected_lux;
+    if !lux_lo.is_finite() || !lux_hi.is_finite() || lux_lo >= lux_hi || lux_lo < 0.0 {
+        return Err(format!(
+            "transfer family `{family_name}`: uncorrected_lux must be two increasing non-negative finite values"
+        ));
+    }
+
+    let scale_lx = f64::from(member.scale_micro_lux_per_count) / 1_000_000.0;
+    let count_lo = (lux_lo / scale_lx).ceil();
+    let count_hi = (lux_hi / scale_lx).floor();
+    if count_lo < 0.0 || count_hi > f64::from(u16::MAX) {
+        // Still representable as a domain after saturation clipping below;
+        // reject only if the low bound itself is unrepresentable.
+    }
+    if count_lo > f64::from(u16::MAX) {
+        return Err(format!(
+            "transfer family `{family_name}`: applicability window starts above the 16-bit observation domain"
+        ));
+    }
+
+    let domain_min = count_lo.max(0.0) as u16;
+    let mut domain_max = count_hi.min(f64::from(u16::MAX)) as u16;
+    if matches!(family.saturation, BoundaryDef::Error) && domain_max == u16::MAX {
+        domain_max = u16::MAX - 1;
+    }
+    if domain_min >= domain_max {
+        return Err(format!(
+            "transfer family `{family_name}`: applicability window contains fewer than two observation codes"
+        ));
+    }
+
+    let member_name = expanded_name(family_name, &member.selectors)?;
+    let model = match &family.model {
+        ModelDef::ScaledPolynomial { coefficients, .. } => ModelDef::ScaledPolynomial {
+            coefficients: coefficients.clone(),
+            scale_micro_lux_per_count: member.scale_micro_lux_per_count,
+        },
+        ModelDef::NtcBetaDivider { .. } => {
+            return Err(format!(
+                "transfer family `{family_name}`: ntc_beta_divider is not a family model; \
+                 declare a standalone transfer"
+            ));
+        }
+    };
+
+    Ok((
+        member_name,
+        TransferDef {
+            input_unit: family.input_unit.clone(),
+            output_unit: family.output_unit.clone(),
+            output_scale: family.output_scale,
+            max_interpolation_error: family.max_interpolation_error,
+            max_knots: family.max_knots,
+            below: family.below,
+            above: family.above,
+            points: None,
+            formula: None,
+            model: Some(model),
+            domain: Some([domain_min, domain_max]),
+            output_range: None,
+        },
+    ))
+}
+
+fn expanded_name(
+    family_name: &str,
+    selectors: &BTreeMap<String, toml::Value>,
+) -> Result<String, String> {
+    if selectors.is_empty() {
+        return Err(format!(
+            "transfer family `{family_name}`: member selectors must not be empty"
+        ));
+    }
+    let mut name = family_name.to_string();
+    for (key, value) in selectors {
+        let token = match value {
+            toml::Value::String(text) => text.clone(),
+            toml::Value::Integer(int) => int.to_string(),
+            other => {
+                return Err(format!(
+                    "transfer family `{family_name}`: selector `{key}` must be a string or integer, got {other}"
+                ));
+            }
+        };
+        name.push('_');
+        name.push_str(&token);
+    }
+    Ok(name)
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use std::vec;
+
+    fn polynomial_family() -> TransferFamilyDef {
+        TransferFamilyDef {
+            input_unit: "als_count".into(),
+            output_unit: "lux".into(),
+            output_scale: 1000,
+            max_interpolation_error: 50,
+            max_knots: 64,
+            max_knots_hard: 256,
+            interpolate_selectors: false,
+            below: BoundaryDef::Error,
+            above: BoundaryDef::Error,
+            saturation: BoundaryDef::Error,
+            extrapolation: BoundaryDef::Error,
+            model: ModelDef::ScaledPolynomial {
+                coefficients: vec![0.0, 1.0023, 8.1488e-5, -9.3924e-9, 6.0135e-13],
+                scale_micro_lux_per_count: 0,
+            },
+            members: vec![FamilyMemberDef {
+                selectors: BTreeMap::from([
+                    ("gain".into(), toml::Value::String("div4".into())),
+                    ("integration_time_ms".into(), toml::Value::Integer(100)),
+                ]),
+                scale_micro_lux_per_count: 268_800,
+                applicability: ApplicabilityDef {
+                    correction: CorrectionKind::Required,
+                    uncorrected_lux: [100.0, 2_200.0],
+                },
+            }],
+        }
+    }
+
+    #[test]
+    fn required_member_expands_to_a_bounded_domain() {
+        let mut families = BTreeMap::new();
+        families.insert("als".into(), polynomial_family());
+        let expanded = expand_families(&families).unwrap();
+        assert_eq!(expanded.len(), 1);
+        let def = expanded
+            .get("als_div4_100")
+            .expect("selector order is BTreeMap");
+        let [lo, hi] = def.domain.expect("domain");
+        assert!(lo < hi);
+        assert_ne!(hi, u16::MAX);
+        match def.model.as_ref() {
+            Some(ModelDef::ScaledPolynomial {
+                scale_micro_lux_per_count: 268_800,
+                ..
+            }) => {}
+            other => panic!("unexpected model {other:?}"),
+        }
+    }
+
+    #[test]
+    fn interpolate_selectors_is_rejected() {
+        let mut family = polynomial_family();
+        family.interpolate_selectors = true;
+        let mut families = BTreeMap::new();
+        families.insert("als".into(), family);
+        let error = expand_families(&families).unwrap_err();
+        assert!(error.contains("interpolate_selectors"));
+    }
+
+    #[test]
+    fn saturation_excludes_u16_max() {
+        let mut family = polynomial_family();
+        family.members[0].applicability.uncorrected_lux = [0.0, 1.0e9];
+        family.members[0].scale_micro_lux_per_count = 4_200;
+        let mut families = BTreeMap::new();
+        families.insert("als".into(), family);
+        let def = &expand_families(&families).unwrap()["als_div4_100"];
+        assert_eq!(def.domain.unwrap()[1], u16::MAX - 1);
+    }
+
+    #[test]
+    fn do_not_use_members_are_not_generated() {
+        let mut family = polynomial_family();
+        family.members[0].applicability.correction = CorrectionKind::DoNotUse;
+        let mut families = BTreeMap::new();
+        families.insert("als".into(), family);
+        let error = expand_families(&families).unwrap_err();
+        assert!(error.contains("no members with correction"));
+    }
+}
