+/// Evaluate `y = poly(scale · x)` on an inclusive observation domain.
+pub fn evaluate_scaled_polynomial(
+    name: &str,
+    coefficients: &[f64],
+    scale_micro_lux_per_count: u32,
+    domain: [u16; 2],
+) -> Result<(u16, Vec<f64>, String), String> {
+    if coefficients.is_empty() {
+        return Err(format!(
+            "transfer `{name}`: scaled_polynomial coefficients must not be empty"
+        ));
+    }
+    for (index, value) in coefficients.iter().enumerate() {
+        if !value.is_finite() {
+            return Err(format!(
+                "transfer `{name}`: scaled_polynomial coefficient {index} must be finite"
+            ));
+        }
+    }
+    if scale_micro_lux_per_count == 0 {
+        return Err(format!(
+            "transfer `{name}`: scaled_polynomial scale_micro_lux_per_count must be positive"
+        ));
+    }
+    let [minimum, maximum] = domain;
+    if minimum >= maximum {
+        return Err(format!(
+            "transfer `{name}`: domain must be strictly increasing"
+        ));
+    }
+    if maximum == u16::MAX {
+        return Err(format!(
+            "transfer `{name}`: domain must not include saturation code {0} (u16::MAX)",
+            u16::MAX
+        ));
+    }
+
+    let scale_lx = f64::from(scale_micro_lux_per_count) / 1_000_000.0;
+    let mut values = Vec::with_capacity(usize::from(maximum - minimum) + 1);
+    for code in minimum..=maximum {
+        let uncorrected = scale_lx * f64::from(code);
+        let mut acc = 0.0;
+        for &coefficient in coefficients.iter().rev() {
+            acc = acc * uncorrected + coefficient;
+        }
+        if !acc.is_finite() {
+            return Err(format!(
+                "transfer `{name}`: scaled_polynomial produced a non-finite value at code {code}"
+            ));
+        }
+        values.push(acc);
     }
+
+    Ok((
+        minimum,
+        values,
+        format!(
+            "scaled polynomial ({} coefficients, {scale_micro_lux_per_count} µlx/count)",
+            coefficients.len()
+        ),
+    ))
 }
 
